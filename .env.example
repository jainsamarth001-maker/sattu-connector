# Your API keys. setup.command fills these in for you. Never share this file.
# The Odds API - bookmaker odds (free: 500 credits/month): https://the-odds-api.com
ODDS_API_KEY=
# football-data.org - fixtures, table, head-to-head (free: 10 requests/min): https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=
# API-Football - live match and player stats (free: 100 requests/day): https://dashboard.api-football.com/register
API_FOOTBALL_KEY=
# CricketData.org - cricket schedule and scores (free: 100 hits/day): https://cricketdata.org/signup.aspx
CRICKETDATA_API_KEY=
# Betfair Exchange, read-only (optional, free). Use the "Version 1.0-Delay" app key:
# https://betfair-datascientists.github.io/api/apiappkey/
# Your password stays in this file on your Mac (setup.command makes it readable only by you).
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=

# Times are shown in this zone (IANA name, e.g. Australia/Brisbane, Australia/Sydney, Asia/Kolkata)
LOCAL_TZ=Australia/Brisbane

# Optional: phone notifications for alerts. Install the free "ntfy" app, subscribe to a long random topic
# name (anyone who knows the name can read it), and put the same name here.
NTFY_TOPIC=

# Alerts: bookmaker region, how far ahead to watch, and credit pacing
ALERT_REGIONS=au
# Where alert prices come from: auto (Betfair if set up, else The Odds API), betfair, oddsapi
ALERT_SOURCE=auto
ALERT_WINDOW_HOURS=36
ALERT_MIN_INTERVAL_MIN=15
ODDS_MONTHLY_CREDITS=500
# Day of the month your Odds API credits reset (the day you signed up)
ODDS_RESET_DAY=1

# Stop calling a provider when fewer than this many units would remain
ODDS_RESERVE=20
FOOTBALL_RESERVE=5
CRICKET_RESERVE=5
